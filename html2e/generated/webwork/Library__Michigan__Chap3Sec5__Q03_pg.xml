    <statement><p>Find the derivative of 
<m>s(q) = 15 \cos q \sin q</m>.</p>
<p><m>s'(q) =</m> <fillin characters="65" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>15\mathopen{}\left(-1\sin\mathopen{}\left(q\right)\sin\mathopen{}\left(q\right)+\cos\mathopen{}\left(q\right)\cos\mathopen{}\left(q\right)\right)</m>
      </p>
    </answer>
    <solution><m>s'(q) = 15 (-\sin(q) \sin(q) + \cos(q) \cos(q))</m>



<m>\phantom{s'(q)} = 15 (-\sin^2(q) + \cos^2(q)).</m>



</solution>
