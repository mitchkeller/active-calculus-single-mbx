    <answer>
      <p>
        <m>\left(\sqrt{x}+5x^{10}\right)\cdot 5x^{4}-x^{5}\mathopen{}\left(\frac{1}{2\sqrt{x}}+50x^{9}\right)</m>
      </p>
    </answer>
    <answer>
