    <statement><p>Find the first five terms of the Taylor series for
the function <m>f(x) = \ln\mathopen{}\left(x\right)</m> about the point <m>a = 10</m>.
(Your answers should include the variable x when appropriate.)</p>
<p><m>\ln\mathopen{}\left(x\right) =</m>
<fillin characters="15" name="AnSwEr0001"/> +
<fillin characters="15" name="AnSwEr0002"/> +
<fillin characters="15" name="AnSwEr0003"/> +
<fillin characters="15" name="AnSwEr0004"/> +
<fillin characters="15" name="AnSwEr0005"/> + ...</p>
</statement>
    <answer>
      <p>
        <m>\ln\mathopen{}\left(10\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{1}{10}\mathopen{}\left(x-10\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{-\left(\frac{1}{10}\right)^{2}}{2}\mathopen{}\left(x-10\right)^{2}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{\left(\frac{1}{10}\right)^{3}}{3}\mathopen{}\left(x-10\right)^{3}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{-\left(\frac{1}{10}\right)^{4}}{4}\mathopen{}\left(x-10\right)^{4}</m>
      </p>
    </answer>
