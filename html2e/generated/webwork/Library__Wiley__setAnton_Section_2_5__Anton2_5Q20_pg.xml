    <statement><p>Find <m>\frac{d^2y}{dx^2}</m> for <me>y=\sec\mathopen{}\left(x\right)</me></p>
<p><m>\frac{d^2y}{dx^2} =</m> <fillin characters="40" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\sec\mathopen{}\left(x\right)\tan^{2}\mathopen{}\left(x\right)+\sec^{3}\mathopen{}\left(x\right)</m>
      </p>
    </answer>
    <solution><me>y'(x)=\frac{dy}{dx}=\frac{d}{dx}[\sec\mathopen{}\left(x\right)]=\sec\mathopen{}\left(x\right)\tan\mathopen{}\left(x\right)</me>
<me>y''(x)=\frac{d^2y}{dx^2}=\frac{d}{dx}[y'(x)]=\frac{d}{dx}[\sec\mathopen{}\left(x\right)\tan\mathopen{}\left(x\right)]=\sec\mathopen{}\left(x\right)\tan\mathopen{}\left(x\right)\tan\mathopen{}\left(x\right)+\sec^{2}\mathopen{}\left(x\right)\sec\mathopen{}\left(x\right)</me>
<me>\frac{d^2y}{dx^2}=\sec\mathopen{}\left(x\right)\tan^{2}\mathopen{}\left(x\right)+\sec^{3}\mathopen{}\left(x\right)</me>


</solution>
