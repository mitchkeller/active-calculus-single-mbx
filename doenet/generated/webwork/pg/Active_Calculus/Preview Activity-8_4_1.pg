# Section
############################################################
Section::Begin("");

BEGIN_PGML
Consider the function [`f(x) = 9(3 + x)^{-1}`] and fill out the table below.

>> [@DataTable(
  [
    [[PGML('[`f(x) = 9 (3 + x)^{-1}`]'),
      halign => 'l',],
     PGML('[`f(0) = {}`][_]{3}{10}'),
    ],
    [PGML(q"[`f'(x) = {}`][_]{'-9(3 + x)^(-2)'}{20}"),
     PGML(q"[`f'(0) = {}`][_]{-1}{10}"),
    ],
    [PGML(q"[`f''(x) = {}`][_]{'18(3 + x)^(-3)'}{20}"),
     PGML(q"[`f''(0) = {}`][_]{Fraction(2,3)}{10}"),
    ],
    [PGML(q"[`f'''(x) = {}`][_]{'-54(3 + x)^(-4)'}{20}"),
     PGML(q"[`f'''(0) = {}`][_]{Fraction(-2,3)}{10}"),
    ],
  ],
      align => '*{2}{r}',
      valign => 'middle',);@]* <<

Use your answers to calculate the degree [`3`] Taylor polynomial centered at [`0`] for [`f(x)\text{.}`]

[_]{'3 - x + 1/3 x^2 - 1/9 x^3'}{10}

END_PGML

Section::End();

