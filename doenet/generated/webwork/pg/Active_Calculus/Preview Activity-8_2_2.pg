############################################################
Section::Begin("");

BEGIN_PGML
Complete the table below by computing derivatives of [`T_3(x)`] and evaluating them and the derivatives of [`\sin(x)`] at [`x=0`] as directed.

[@KeyboardInstructions('Use underscores to enter the coefficients.  For example, to enter [`c_1\text{,}`] type "c\_1".')@]**

>> [@DataTable(
  [
    [
     PGML('[`f(x)=`]'),
     PGML('[`\sin(x)`]'),
     PGML('[`T_3(x)=`]'),
     PGML('[`c_0+c_1x+c_2x^2+c_3x^3`]'),
    ],
    [
     PGML(q"[`f'(x)=`]"),
     PGML('[`\cos(x)`]'),
     PGML(q"[`T_3'(x)=`]"),
     PGML('[_]{$T3prime}{10}'),
    ],
    [
     PGML(q"[`f''(x)=`]"),
     PGML('[`-\sin(x)`]'),
     PGML(q"[`T_3''(x)=`]"),
     PGML('[_]{$T3doubleprime}{10}'),
    ],
    [
     [PGML(q"[`f'''(x)=`]"),
      rowbottom => '3',
      midrule => '1',],
     PGML('[`-\cos(x)`]'),
     PGML(q"[`T_3'''(x)=`]"),
     PGML('[_]{$T3tripleprime}{10}'),
    ],
    [
     PGML('[`f(0)=`]'),
     PGML('[_]{0}{10}'),
     PGML('[`T_3(0)=`]'),
     PGML('[`c_0`]'),
    ],
    [
     PGML(q"[`f'(0)=`]"),
     PGML('[_]{1}{10}'),
     PGML(q"[`T_3'(0)=`]"),
     PGML('[_]{$const1}{10}'),
    ],
    [
     PGML(q"[`f''(0)=`]"),
     PGML('[_]{0}{10}'),
     PGML(q"[`T_3''(0)=`]"),
     PGML('[_]{$const2}{10}'),
    ],
    [
     PGML(q"[`f'''(0)=`]"),
     PGML('[_]{-1}{10}'),
     PGML(q"[`T_3'''(0)=`]"),
     PGML('[_]{$const3}{10}'),
    ],
  ],
      align => 'rl|rl',
      valign => 'middle',
      top => '3',);@]* <<

END_PGML

Section::End();

