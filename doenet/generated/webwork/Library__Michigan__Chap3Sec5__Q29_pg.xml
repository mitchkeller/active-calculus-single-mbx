    <statement><p>Find the derivative of 
<m>h(t) = t \tan t + \cos t</m></p>
<p><m>h'(t) =</m> <fillin characters="65" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\tan\mathopen{}\left(t\right)+t\frac{1}{\cos^{2}\mathopen{}\left(t\right)}+-1\sin\mathopen{}\left(t\right)</m>
      </p>
    </answer>
    <solution><me>h'(t) = \tan(t) + t (\frac{1}{\cos^2(t)}) - \sin(t)</me>



</solution>
