    <statement><p>Find <m>\frac{d^2y}{dx^2}</m> for <me>y=\csc\mathopen{}\left(x\right)</me></p>
<p><m>\frac{d^2y}{dx^2} =</m> <fillin characters="40" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\csc\mathopen{}\left(x\right)\cot^{2}\mathopen{}\left(x\right)+\csc^{3}\mathopen{}\left(x\right)</m>
      </p>
    </answer>
    <solution><me>y'(x)=\frac{dy}{dx}=\frac{d}{dx}[\csc\mathopen{}\left(x\right)]=-\left(\csc\mathopen{}\left(x\right)\cot\mathopen{}\left(x\right)\right)</me>
<me>y''(x)=\frac{d^2y}{dx^2}=\frac{d}{dx}[y'(x)]=\frac{d}{dx}[-\left(\csc\mathopen{}\left(x\right)\cot\mathopen{}\left(x\right)\right)]=\csc\mathopen{}\left(x\right)\cot\mathopen{}\left(x\right)\cot\mathopen{}\left(x\right)+\csc^{2}\mathopen{}\left(x\right)\csc\mathopen{}\left(x\right)</me>
<me>\frac{d^2y}{dx^2}=\csc\mathopen{}\left(x\right)\cot^{2}\mathopen{}\left(x\right)+\csc^{3}\mathopen{}\left(x\right)</me>


</solution>
